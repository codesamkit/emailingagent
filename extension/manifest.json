{
  "manifest_version": 3,
  "name": "Valence",
  "version": "0.1.0",
  "description": "Importance badges, summaries, reply outlines, and calendar proposals from your local Valence email agent, inside Gmail.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content/api.js", "content/ask.js", "content/inbox.js", "content/detail.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
